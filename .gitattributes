# Автоопределение текстовых файлов и нормализация переводов строк
* text=auto

# Windows bat-скрипты с UTF-8 без BOM
*.bat text eol=crlf
*.cmd text eol=crlf

# PowerShell скрипты - UTF-8 с BOM
*.ps1 text eol=crlf working-tree-encoding=UTF-8

# HTML с кириллицей
*.html text eol=lf working-tree-encoding=UTF-8